# ── InvestAgent ── Example Environment Configuration ──────────
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file — it's in .gitignore.

# ── LLM API (for TradingAgents multi-agent pipeline) ──────────
# Pick ONE provider and fill in the corresponding key.
# Supported: openai, anthropic, google, deepseek, qwen, minimax

LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-4

# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5.5

# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# ── Data sources (optional — InvestAgent falls back to web search) ──

# Alpha Vantage — free API for US equity data
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=demo

# Twelve Data — paid API with broad international coverage
TWELVE_DATA_API_KEY=

# Finnhub — free tier available
FINNHUB_API_KEY=

# ── QuantDinger backtest service (optional) ──────────────────
# If you want to use the dockerized backtest engine, start it:
#   cd skills/QuantDinger && docker-compose up -d

QUANTDINGER_API_URL=http://localhost:5000
QUANTDINGER_ENABLED=true

# ── Automation / notifications (optional) ─────────────────────

# Email notifications for daily research
# (leave empty to skip notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# Telegram notifications
# (leave TELEGRAM_BOT_TOKEN empty to skip)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Runtime behavior ──────────────────────────────────────────

# Research depth: quick, normal, deep
RESEARCH_DEPTH=normal

# Timezone for daily scheduling
TZ=Asia/Shanghai

# Output language — zh or en
OUTPUT_LANGUAGE=zh

# ── End of configuration ──────────────────────────────────────
